# Local demo database. Prisma resolves this relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
WORKER_DATABASE_URL=""
MONITOR_DATABASE_URL=""
DATABASE_ROLE="app"
# Operator-only inputs for `db:provision:postgres-logins`; never mount these in web/worker containers.
TEMPOCOVE_MIGRATION_DB_PASSWORD=""
TEMPOCOVE_APP_DB_PASSWORD=""
TEMPOCOVE_WORKER_DB_PASSWORD=""
TEMPOCOVE_MONITOR_DB_PASSWORD=""

# Use a long random value outside source control. NEXTAUTH_SECRET is accepted as a fallback.
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_SECRET=""
# Versioned signing key for booking bootstrap capabilities. On rotation, keep
# prior id/secret pairs in the JSON keyring until every old capability expires.
BOOKING_CAPABILITY_KEY_ID="booking-capability-v1"
BOOKING_CAPABILITY_SECRET="replace-with-an-independent-32-byte-random-value"
BOOKING_CAPABILITY_KEYRING="{}"
TOKEN_ENCRYPTION_KEY="replace-with-64-random-hex-characters"
# Shared client gate for the public booking surface. Store only the scrypt hash
# (`npm run setup` generates one and prints the password once). Bump the version
# integer on rotation to invalidate every outstanding gate cookie at once.
CLIENT_GATE_PASSWORD_HASH="replace-with-a-scrypt-client-gate-password-hash"
CLIENT_GATE_SECRET="replace-with-an-independent-32-byte-client-gate-secret"
CLIENT_GATE_PASSWORD_VERSION="1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Origin isolation for split deployments: "book" serves the client gate/booking/manage surface,
# "admin" serves the dashboard. Leave empty for the single-origin local demo; production requires it.
SURFACE=""
DEMO_MODE="true"
DEMO_HOST_EMAIL="owner@example.com"
DEMO_HOST_PASSWORD="replace-with-a-strong-demo-password"
OPERATOR_HEALTH_SECRET=""

# Google Calendar is opt-in and only mirrors appointments; availability is always computed from the
# database. The default local provider makes no network calls.
CALENDAR_PROVIDER="local"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# Environment-managed Google credentials are local-demo-only and must be bound to one immutable workspace ID.
GOOGLE_ENV_WORKSPACE_ID=""
GOOGLE_CALENDAR_ID="primary"

# Hours before the appointment that the reminder email is scheduled (1–168; the
# confirmation doubles as the reminder for bookings made inside the lead window).
BOOKING_REMINDER_LEAD_HOURS="24"

# Standard `npm run dev` keeps the local outbox poller alive.
# Keep the Node process long-lived so calendar and email jobs continue to drain.
OUTBOX_WORKER_ENABLED="true"
OUTBOX_POLL_INTERVAL_MS="5000"
EMAIL_PROVIDER="local"
EMAIL_TOKEN_SECRET=""
TENANT_CONTEXT_SECRET=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_TLS_MODE="starttls"
SMTP_USER=""
SMTP_PASSWORD=""
# Production examples: Dvision Studio <bookings@your-domain.com>, hello@your-domain.com, your-domain.com
EMAIL_FROM=""
EMAIL_REPLY_TO=""
EMAIL_SENDER_DOMAIN=""
DATABASE_PROVIDER="sqlite"
RATE_LIMIT_PROVIDER="local"
RATE_LIMIT_HASH_SECRET=""
RATE_LIMIT_MAX_BUCKETS="100000"
TRUST_PROXY="false"
# Required only when TRUST_PROXY=true. The trusted proxy must inject this secret after stripping client copies.
PROXY_SHARED_SECRET=""
OUTBOX_WORKER_MODE="local"
WORKER_SHUTDOWN_TIMEOUT_MS="30000"
BUILD_ID="development"

# Stripe test mode is opt-in. Live keys are rejected and paid events fail closed until configured.
PAYMENTS_PROVIDER="stub"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Nonproduction demo only. Enables a Stripe CLI claimable-sandbox `rkcs_` credential; ignored by production policy.
STRIPE_CLAIMABLE_SANDBOX="false"

# Reverse-proxy ingress (infrastructure/caddy/Caddyfile). BOOK_HOST and ADMIN_HOST are the public
# hostnames Caddy serves and must match NEXT_PUBLIC_APP_URL for each surface; ACME_EMAIL receives
# Let's Encrypt expiry and revocation notices.
BOOK_HOST=book.your-domain.example
ADMIN_HOST=admin.your-domain.example
ACME_EMAIL=operations@your-domain.example
# Optional: where booking notices for the studio are delivered. Unset means the organizer's own
# account address. Set it to a shared shop mailbox to keep notices out of a personal inbox.
ORGANIZER_NOTIFICATION_EMAIL=
